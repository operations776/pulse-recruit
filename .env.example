# Copy to .env.local for local development.
# Every var here must also exist in the ARCHITECTURE.md table and the Vercel
# project config, added in the same commit as the code that reads it.

# Supabase project "pulse" (eu-west-2). Never point this at the retainer
# dashboard or the old Pulse Recruit project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Absolute origin. Needed in deployed environments so auth redirects land on
# the right host. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://pulse.recruitergtm.io

# --- Platform AI keys (AI.md section 1) -------------------------------------
# These are RecruiterGTM's own keys, not the customer's. One central account,
# every org spends against it, credits are the cost control. Server only: never
# prefixed NEXT_PUBLIC_, never read outside src/lib/server/ai/.
# Check them with: npm run verify:ai
OPENAI_API_KEY=sk-xxx
EXA_API_KEY=xxx

# Optional. Changing the model means updating MODEL_RATES in
# src/lib/server/ai/pricing.ts in the same commit, or the credit meter lies.
# OPENAI_MODEL=gpt-4o

# --- Per-org integration keys are NOT env vars ------------------------------
# Instantly, HeyReach, Unipile, Beehiiv and custom SMTP are the customer's own
# accounts. Each org pastes its own key into Settings and it is stored
# encrypted in Supabase Vault, so it can be rotated per customer without a
# deploy. See ARCHITECTURE.md and AI.md.
